# AI Coordination Engine — Test Environment Configuration
#
# Copy this file to .env and fill in your credentials.
# Never commit the .env file with real secrets.
#
# This file is consumed by:
#   - tests/test_ai_coordination_engine.py (unittest-based integration tests)
#   - tests/test_integration_scenarios.py (pytest-based SOP scenarios)
#   - tests/test_postgresql_repositories.py (repo-level PG CRUD tests)
#   - tests/test_dual_backend_guard.py (dispatch + adoption guard)
#   - tests/test_benchmarks.py (performance benchmarks)
#   - tests/run_live_integration.py (live GraphQL call recorder for certification)

# ── 1. Local Source Layout ──────────────────────────────────────────────── #
# Absolute path to the silvaengine monorepo root.
# Used by test files to extend sys.path for all sibling modules.
base_dir=C:/Users/bibo7/gitrepo/silvaengine
# base_dir=/home/bibo7/gitrepo/silvaengine

# ── 2. AWS Credentials ──────────────────────────────────────────────────── #
# Required for DynamoDB access (when db_backend=dynamodb) and for AWS service
# calls (Lambda, S3, SES) even in PostgreSQL mode.
# Multiple profiles below — uncomment exactly one set.

## ideabosque dev
region_name=us-west-2
aws_access_key_id=<your-aws-access-key-id>
aws_secret_access_key=<your-aws-secret-access-key>

## ideabosque prod
# region_name=us-west-2
# aws_access_key_id=<your-prod-access-key-id>
# aws_secret_access_key=<your-prod-secret-access-key>

# ── 3. Deployed API ─────────────────────────────────────────────────────── #
# Only used by remote integration tests that call the deployed API directly.
api_id=<your-api-gateway-id>
api_stage=beta
api_url=https://<api-gateway-host>/<stage>/core/{endpoint_id}/ai_agent_core_graphql
api_key=<your-api-key>

# ── 4. Engine Tenancy / Partitioning ────────────────────────────────────── #
endpoint_id=gpt
part_id=nestaging
# NOTE: execute_mode is no longer used by the engine. Async dispatch always runs
# in-process via Invoker.invoke_funct_on_local + the functs_on_local mapping
# (see section 7). AWS Lambda invocation has been removed entirely.

# ── 5. Dual-Backend Selection ────────────────────────────────────────────── #
# Selects the active persistence backend at initialization time.
#   dynamodb   (default) — uses the AWS credentials in section 2.
#   postgresql           — uses the PostgreSQL connection in section 6;
#                          AWS credentials are still required for FunctionModel.
db_backend=dynamodb

# ── 6. PostgreSQL Connection ────────────────────────────────────────────── #
# Used only when db_backend=postgresql.
# DATABASE_URL takes precedence over PG_* individual fields if set.
# DATABASE_URL=postgresql+psycopg2://silvaengine:silvaengine@localhost:5432/silvaengine
PG_HOST=localhost
PG_PORT=5432
PG_USER=silvaengine
PG_PASSWORD=<your-pg-password>
PG_DB=silvaengine

# Table prefix for ACE tables in PostgreSQL (prepended to all table/index names).
# Leave empty for no prefix. When running multiple engines in the same DB,
# use per-module prefixes (e.g. "ace_") to avoid collision.
PG_TABLE_PREFIX=
ACE_PG_TABLE_PREFIX=

# ── 7. Internal Invoke (functs_on_local) ────────────────────────────────── #
# The engine always invokes its async functions in-process via
# Invoker.invoke_funct_on_local using the functs_on_local mapping (configured
# in the engine setting dict, e.g. tests/test_ai_coordination_engine.py).
# AWS Lambda dispatch has been removed entirely, so functs_on_local must be
# configured for async_insert_update_session, async_execute_procedure_task_session,
# async_update_session_agent, and async_orchestrate_task_query.

# Internal MCP for ai_agent_core_engine (used by AACE _get_agent() at runtime).
# Set to the gateway MCP endpoint for the target partition.
internal_mcp_base_url=https://<gateway-host>/<stage>/core/{endpoint_id}/mcp
x-api-key=<your-x-api-key>
internal_mcp_token_username=
internal_mcp_token_password=
internal_mcp_bearer_token=

# ── 8. Async Task Configuration ──────────────────────────────────────────── #
task_queue_name=silvaengine_task_queue.fifo
# async_task_timeout=300        # seconds — timeout for async task completion check
# graphql_timeout=300           # seconds — timeout for GraphQL execution

# ── 9. Cache ────────────────────────────────────────────────────────────── #
cache_enabled=0  # 0 = disabled, 1 = enabled (HybridCacheEngine)

# ── 10. Schema Initialization ───────────────────────────────────────────── #
# When 1, the engine auto-creates tables on initialization (DynamoDB or PostgreSQL).
# Set to 0 in production; use Alembic migrations instead.
initialize_tables=0

# ── 11. Optional Settings ──────────────────────────────────────────────── #
# source_email=<your-ses-sender-email>          # SES sender for notification emails
# module_bucket_name=<your-s3-bucket>           # S3 bucket for module package storage
# funct_zip_path=/tmp/funct_zips                # local path for extracted function zips
# funct_extract_path=/tmp/functs                # local path for extracted function modules
# connection_id=<websocket-connection-id>      # WebSocket connection ID for real-time updates

# ── 12. Sibling Module Paths (sys.path) ────────────────────────────────── #
# The test files extend sys.path with these paths under base_dir.
# They must exist for the engine to import agent handlers at runtime.
# No configuration needed — derived from base_dir automatically:
#   {base_dir}/ai_coordination_engine
#   {base_dir}/silvaengine_utility
#   {base_dir}/silvaengine_dynamodb_base
#   {base_dir}/ai_agent_core_engine
#   {base_dir}/ai_agent_handler
#   {base_dir}/openai_agent_handler
#   {base_dir}/ai_agent_funct_base
#   {base_dir}/ai_marketing_engine
#   {base_dir}/anthropic_agent_handler
#   {base_dir}/gemini_agent_handler
#   {base_dir}/travrse_agent_handler
#   {base_dir}/shopify_connector
#   {base_dir}/mcp_http_client